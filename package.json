{
  "name": "@dexvis/threejs-tree-editor",
  "version": "0.1.0",
  "description": "Three.js scene-tree editing, merging and outlining utilities for detector geometry (rulesets, skip-flags, geometry processor)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "threejs",
    "3d",
    "editor",
    "root",
    "cern"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.183.1",
    "typescript": "^5.8.3",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^4.0.18",
    "three": "^0.183.2"
  },
  "peerDependencies": {
    "three": ">=0.128.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dexvis/root-geo-tree-editor": "^0.1.1"
  }
}